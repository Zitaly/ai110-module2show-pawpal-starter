classDiagram
    %% PawPal+ system design draft.
    %% Keep this file updated so it matches your final implementation.

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Owner {
        +str name
        +int available_minutes
        +time day_start
        +bool prefer_high_priority_first
        +int max_tasks_per_day
        +list~Pet~ pets
        +dict~date, Schedule~ schedules
        +day_end() time
        +add_pet(pet: Pet) None
        +remove_pet(pet: Pet) None
        +all_tasks() list~Task~
        +create_schedule(day: date) Schedule
    }

    class Pet {
        +str name
        +str species
        +int age
        +str notes
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) None
        +due_tasks(day: date) list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +Priority priority
        +time preferred_time
        +str frequency
        +date start_date
        +date last_completed
        +str pet_name
        +label() str
        +mark_complete(day: date) None
        +is_due(day: date) bool
    }

    class Schedule {
        +date day
        +Owner owner
        +list~tuple[time, Task]~ planned
        +list~Task~ skipped
        +dict~str, str~ reasons
        +generate() None
        -_collect_due_tasks() list~Task~
        -_sort_tasks(tasks: list~Task~) list~Task~
        -_place_fixed_tasks(tasks: list~Task~) list~Task~
        -_fill_flexible_tasks(tasks: list~Task~) None
        +total_minutes() int
        +has_conflicts() bool
        +explain() str
    }

    Owner "1" o-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : needs
    Owner "1" --> "0..*" Schedule : plans
    Schedule "1" --> "0..*" Task : orders
    Task --> Priority : ranked by
