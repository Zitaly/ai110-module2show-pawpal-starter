classDiagram
    %% PawPal+ system design, matching pawpal_system.py.
    %% "?" after a type means it can be None.
    %% Owner.day_end, Pet.task_count, and Task.label are Python @property attributes, drawn as methods.
    %% "$" marks a static member.

    class pawpal_system {
        <<utility>>
        +dict~str, int~ FREQUENCY_DAYS$
        +int MINUTES_PER_DAY$
        +add_minutes(start: time, minutes: int)$ time
        +minutes_between(start: time, end: time)$ int
        +fmt(t: time)$ str
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Owner {
        +str name
        +int available_minutes
        +time day_start
        +bool prefer_high_priority_first
        +int? max_tasks_per_day
        +list~Pet~ pets
        +dict~date, Schedule~ schedules
        +day_end() time
        +set_window(day_start: time, available_minutes: int) None
        -_check_window(day_start: time?, available_minutes: int?)$ None
        +add_pet(pet: Pet) None
        +remove_pet(pet: Pet) None
        +all_tasks() list~Task~
        +filter_tasks(pet_name: str?, completed: bool?, day: date?) list~Task~
        +create_schedule(day: date) Schedule
    }

    class Pet {
        +str name
        +str species
        +int age
        +str notes
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) None
        +complete_task(task: Task, day: date) Task
        +due_tasks(day: date) list~Task~
        +task_count() int
    }

    class Task {
        +str title
        +int duration_minutes
        +Priority priority
        +time? preferred_time
        +str frequency
        +date start_date
        +date? last_completed
        +str pet_name
        +Pet? pet
        +label() str
        +mark_complete(day: date) None
        +last_occurrence(day: date) date?
        +next_occurrence(day: date) Task
        +is_completed(day: date) bool
        +is_due(day: date) bool
        +is_overdue(day: date) bool
    }

    class Schedule {
        +date day
        +Owner owner
        +list~tuple[time, Task]~ planned
        +list~Task~ skipped
        +dict~Task, str~ reasons
        +dict~Task, list~Task~~ conflicts
        +generate() None
        -_place(tasks: list~Task~) None
        -_collect_due_tasks() list~Task~
        -_sort_tasks(tasks: list~Task~) list~Task~
        -_place_fixed_tasks(tasks: list~Task~) list~Task~
        -_relocate(task: Task) None
        -_fill_flexible_tasks(tasks: list~Task~) None
        -_free_gaps() list~list~int~~
        -_overlaps(start_a: time, task_a: Task, start_b: time, task_b: Task)$ bool
        +sort_by_time() None
        -_plan(start: time, task: Task, reason: str) None
        -_skip(task: Task, reason: str) None
        +total_minutes() int
        +has_conflicts() bool
        +conflict_messages() list~str~
        +explain() str
    }

    Owner "1" o-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : needs
    Task "0..*" --> "0..1" Pet : belongs to
    Owner "1" --> "0..*" Schedule : plans
    Schedule "0..*" --> "1" Owner : reads constraints from
    Schedule "1" --> "0..*" Task : orders and records conflicts
    Task ..> Task : creates next occurrence
    Task --> Priority : ranked by
